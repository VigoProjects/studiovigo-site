---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import BlockRenderer from "../components/BlockRenderer.astro";
const page = await getEntry("pages", "home");
if (!page) throw new Error("src/content/pages/home.yaml is missing");
const { title, description, ogImage, blocks } = page.data;
---
<Base {title} {description} {ogImage}><BlockRenderer {blocks} /></Base>
