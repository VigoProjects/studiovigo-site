---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleHero from "../../components/article/ArticleHero.astro";
import ArticleFlow from "../../components/article/ArticleFlow.astro";
import Text from "../../components/mdx/Text.astro";
import { mdxComponents } from "../../components/mdx";

export async function getStaticPaths() {
  const posts = await getCollection("insights", (e) => !e.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
// Plain .md articles are one text column; .mdx articles lay out their own sections.
const isMdx = post.filePath?.endsWith(".mdx");
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  datePublished: d.date.toISOString(),
  author: { "@type": "Person", name: d.author },
  publisher: { "@type": "Organization", name: "Vigo Projects Limited" },
  ...(d.heroImage ? { image: new URL(d.heroImage, Astro.site).href } : {}),
};
---
<Base title={d.title} metaTitle={d.metaTitle} description={d.description} ogImage={d.ogImage ?? d.heroImage} type="article">
  <article>
    <ArticleHero title={d.title} color={d.heroColor} textColor={d.heroTextColor} image={d.heroImage} />
    <ArticleFlow>
      {isMdx ? <Content components={mdxComponents} /> : <Text><Content /></Text>}
    </ArticleFlow>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
