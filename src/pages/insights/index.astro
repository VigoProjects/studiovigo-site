---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import InsightCard from "../../components/InsightCard.astro";
const posts = (await getCollection("insights", (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Insights" description="Here's where we note down our experiences, expertise and perspective.">
  <section class="container pt-32 pb-14 lg:pb-31">
    <h1 class="text-4xl font-bold text-gray-500 md:text-5xl">Insights</h1>
    <p class="mt-4 text-smx text-gray-400">Here's where we note down our experiences, expertise and perspective</p>
    <div class="mt-14 grid gap-x-10 gap-y-14 md:grid-cols-2 lg:grid-cols-3">{posts.map((p) => <InsightCard entry={p} />)}</div>
  </section>
</Base>
