---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/blocks/PageHeader.astro";
import ListingCard from "../../components/ListingCard.astro";
const posts = (await getCollection("insights", (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Insights" description="Experience, expertise and perspective from Vigo on digital product strategy, UX design and enterprise platforms." breadcrumbs={[["Insights", "/insights"]]}>
  <PageHeader type="pageHeader" background="white" eyebrow="Insights" heading="Here's where we note down our experiences, expertise and perspective" />
  <div class="container my-16">
    <div class="grid lg:grid-cols-3 gap-6 xl:gap-12 xl:w-fit xl:mx-auto">
      {posts.map((p, i) => <ListingCard href={`/insights/${p.id}`} title={p.data.title} image={p.data.listingImage ?? p.data.heroImage} author={p.data.author} date={p.data.date} index={i} />)}
    </div>
  </div>
</Base>
