---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const items = await getCollection("caseStudies");
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.description} ogImage={d.image}>
  <header class="bg-gray-200">
    <div class="container flex flex-col gap-y-6 pt-32 pb-14">
      {d.logo && <img src={d.logo} alt={d.client} class="h-12 w-auto self-start" />}
      <ul class="flex flex-wrap gap-2">{d.tags.map((t) => <li class="rounded-full bg-white px-3 py-1 text-2xs font-medium text-gray-400">{t}</li>)}</ul>
      <h1 class="max-w-4xl text-4xl font-bold text-gray-500 md:text-5xl md:leading-tight">{d.headline}</h1>
    </div>
  </header>
  <article class="container py-14 lg:py-24">
    <div class="prose prose-lg prose-gray mx-auto max-w-3xl prose-headings:text-gray-500 prose-img:rounded-3xl"><Content /></div>
  </article>
</Base>
