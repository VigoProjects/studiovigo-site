---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleHero from "../../components/article/ArticleHero.astro";
import ArticleFlow from "../../components/article/ArticleFlow.astro";
import { mdxComponents } from "../../components/mdx";

export async function getStaticPaths() {
  const items = await getCollection("caseStudies", (e) => !e.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} metaTitle={d.title} description={d.description} ogImage={d.ogImage ?? d.heroImage ?? d.listingImage} type="article">
  <article>
    <ArticleHero title={d.heading} color={d.heroColor} textColor={d.heroTextColor} image={d.heroImage} />
    <ArticleFlow><Content components={mdxComponents} /></ArticleFlow>
  </article>
</Base>
