---
/** Large animated homepage card for a case study. Art comes from the case study's `featuredCard` front matter. */
import type { CollectionEntry } from "astro:content";
import { gradientFor } from "../lib/gradients";
interface Props { entry: CollectionEntry<"caseStudies">; index: number }
const { entry, index } = Astro.props;
const d = entry.data;
const art = d.featuredCard!;
const cardId = `case-study-card-${entry.id.replace(/[^a-z0-9-]/gi, "")}`;
const g = gradientFor(index);
const css = `#${cardId}{background-color:${art.color}}@media (min-width:992px){#${cardId}{background-color:${art.colorDesktop}}#${cardId}:hover{background-color:${art.colorHover}!important}}`;
---
<style set:html={css}></style>
<a href={`/case-studies/${entry.id}`} class="relative group md:flex md:flex-1 md:scale-[98%] md:hover:scale-100 transition-all duration-500 ease-out">
  <div class="transition-opacity duration-500 ease-out pointer-events-none opacity-0 lg:group-hover:opacity-100">
    <div class={`absolute inset-0 -z-10 w-full h-full opacity-10 blur-sm card-gradient-${g}`}></div>
    <div class={`absolute inset-0 -z-10 w-full h-full opacity-50 scale-90 blur-2xl card-gradient-${g}`}></div>
  </div>
  <div id={cardId} class="rounded-lgx w-full bg-white overflow-hidden relative md:flex lg:flex-col lg:h-[440px] xl:h-[500px]">
    {art.background && <img src={art.background.src} alt="" class={art.background.class} loading="lazy" />}
    <div class="rounded-t-lgx h-50 md:w-64 md:h-auto md:aspect-square md:flex-none flex justify-center items-center md:rounded-t-none md:rounded-l-lgx lg:rounded-lgx lg:w-full lg:h-full lg:aspect-auto lg:items-start">
      <img src={art.logo} alt={d.listingTitle} class="w-full h-full max-w-[290px] lg:max-w-none object-contain px-13 py-7 md:p-6.5 lg:w-[153px] xl:w-[180px] lg:h-[107px] xl:h-[125px] lg:object-contain lg:rotate-6 lg:group-hover:scale-125 lg:group-hover:rotate-0 lg:group-hover:-translate-y-8 transition-all duration-500 lg:p-0 lg:mt-20" />
    </div>
    {art.layers.length > 0 && (
      <div class="hidden lg:block absolute inset-0 rotate-6 group-hover:rotate-0 transition-all duration-500">
        {art.layers.map((l) => <img src={l.src} alt="" class={l.class} loading="lazy" />)}
      </div>
    )}
    <div class="bg-white w-full text-center p-4 md:p-8 flex flex-col gap-y-6 md:text-left lg:absolute lg:bottom-0 lg:translate-y-full lg:group-hover:translate-y-0 lg:transition-all lg:duration-500 lg:p-6 lg:gap-y-5 xl:h-[264px]">
      <div class="flex flex-wrap gap-1.5 justify-center md:justify-start">
        {d.tags.map((t) => <p class="py-1 px-3 text-xs font-medium text-white bg-gray-350 rounded-full">{t}</p>)}
      </div>
      <div class="text-smx leading-7 text-gray-400 lg:min-h-[3.5rem]">{d.summary ?? d.heading}</div>
      <div class="flex items-center gap-x-3 w-fit rounded-full text-sm leading-snug font-medium text-gray-500 py-2.25 mx-auto md:mx-0 md:mt-auto">
        Read Case Study
        <svg class="transition-transform duration-500 ease-in-out transform will-change-transform group-hover:translate-x-1" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.59961 6H10.5996M10.5996 6L5.817 1M10.5996 6L5.817 11" stroke="#333" stroke-width="2" stroke-linecap="round" /></svg>
      </div>
    </div>
  </div>
</a>
