---
/**
 * Text section for long-form pages. Usage in .mdx:
 *   <Text title="Summary">
 *
 *   Markdown paragraphs, lists, tables…
 *
 *   </Text>
 */
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="w-full px-4 md:px-22 xl:px-30 flex flex-col gap-y-8 xl:gap-y-14 max-w-[506px] md:max-w-[674px] xl:max-w-[828px] mx-auto">
  {title && <h2 class="text-gray-500 text-xlx xl:text-4xlx xl:leading-tight font-bold">{title}</h2>}
  <div class="article-body prose max-w-none"><slot /></div>
</div>
