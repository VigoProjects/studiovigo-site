---
/** Site header: logo tab (top-left), menu tab (top-right), slide/scale-in menu. Ported from the live site. */
import { getCollection } from "astro:content";
import { site } from "../lib/site";
import Logo from "./Logo.astro";
import Button from "./Button.astro";

const contact = site.nav.find((n) => n.href === "/contact") ?? { label: "Get in Touch", href: "/contact" };
const links = site.nav.filter((n) => n.href !== "/contact");
const all = await getCollection("caseStudies");
const featured = site.menuCaseStudies
  .map((slug) => all.find((c) => c.id === slug))
  .filter((c) => !!c);
const arrow = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.59961 6H10.5996M10.5996 6L5.817 1M10.5996 6L5.817 11" stroke="#fff" stroke-width="2" stroke-linecap="round" /></svg>`;
const close = `<svg class="w-5 h-5" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="3" width="18" height="2" rx="1" transform="rotate(45 4 3)" fill="white" /><rect x="3" y="16" width="18" height="2" rx="1" transform="rotate(-45 3 16)" fill="white" /></svg>`;
---
<header
  class="fixed inset-0 flex justify-between h-fit z-20"
  x-data="{
    modalIsOpen: false,
    isMobile: window.innerWidth < 768,
    getTransitions() {
      return {
        enter: this.isMobile ? '-translate-y-full' : 'scale-0 opacity-0',
        enterEnd: this.isMobile ? 'translate-y-0' : 'scale-100 opacity-100',
        leave: this.isMobile ? 'translate-y-0' : 'scale-100 opacity-100',
        leaveEnd: this.isMobile ? '-translate-y-full' : 'scale-95 opacity-0'
      };
    }
  }"
  x-init="$watch('isMobile', () => { if (modalIsOpen) { const wasOpen = modalIsOpen; modalIsOpen = false; setTimeout(() => { modalIsOpen = wasOpen; }, 10); } });"
  @resize.window="isMobile = window.innerWidth < 768"
>
  <a href="/" aria-label={`${site.name} home`} class="relative after:bg-gray-500 after:w-21 after:h-16 after:lg:w-26 after:lg:h-20 after:clip-header-logo after:block after:absolute after:top-0 after:left-0 after:-z-10 origin-top-left transition-transform duration-500 hover:scale-105">
    <Logo class="w-8.5 h-11 lg:w-10.5 lg:h-13 mt-1.5 ml-5 lg:mt-2.5 lg:ml-7" />
  </a>

  <div class="bg-gray-500 h-14 lg:h-18 clip-hamburger-icon lg:clip-hamburger-menu-xl flex justify-end lg:items-center origin-top-right transition-all duration-500 group hover:scale-105" :class="modalIsOpen ? 'md:opacity-0 md:scale-95' : 'opacity-100 scale-100'">
    <button @click="modalIsOpen = true" x-show="modalIsOpen===false" type="button" class="h-fit cursor-pointer" aria-label="Open menu">
      <svg class="w-5 h-5 mt-4 mr-4.5 ml-7.5 lg:mr-6 lg:mt-0 lg:ml-14" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="1" y="2" width="18" height="2" rx="1" fill="white" /><rect x="1" y="9" width="18" height="2" rx="1" fill="white" /><rect x="1" y="16" width="18" height="2" rx="1" fill="white" />
      </svg>
    </button>
    <button x-cloak @click="modalIsOpen = false" x-show="modalIsOpen" type="button" class="h-fit cursor-pointer md:hidden" aria-label="Close menu">
      <span class="block mt-5 mr-9" set:html={close} />
    </button>
    <div class="hidden lg:block lg:mr-4" x-show="modalIsOpen===false">
      <Button href={contact.href}>{contact.label}</Button>
    </div>
  </div>

  <div x-cloak x-show="modalIsOpen" @click="modalIsOpen = false" class="fixed inset-0 -z-20"></div>
  <div
    x-cloak x-show="modalIsOpen" x-trap.inert.noscroll="modalIsOpen"
    @keydown.esc.window="modalIsOpen = false" @click.self="modalIsOpen = false"
    class="fixed inset-0 md:w-fit md:h-fit md:m-auto md:clip-hamburger-menu lg:inset-auto lg:right-7.5 lg:top-5.5 -z-10 bg-gray-500 pt-30 md:pt-0 transition-all transform"
    x-transition:enter="transition ease-in-out duration-400" x-transition:leave="transition ease-in-out duration-400"
    :class="isMobile ? 'mobile-menu' : 'desktop-menu'"
    x-effect="const t = getTransitions(); $el.setAttribute('x-transition:enter-start', t.enter); $el.setAttribute('x-transition:enter-end', t.enterEnd); $el.setAttribute('x-transition:leave-start', t.leave); $el.setAttribute('x-transition:leave-end', t.leaveEnd);"
    role="dialog" aria-modal="true" aria-label="Menu"
  >
    <div x-show="modalIsOpen" :class="isMobile ? 'px-4 pb-6' : 'px-12 pb-10.5 pt-16'" class="h-full md:h-fit overflow-hidden text-white transition-all flex flex-col justify-between"
      x-transition:enter="transition ease-in-out duration-400" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in-out duration-400" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
      <div class="hidden md:flex items-center justify-between mb-11">
        <button @click="modalIsOpen = false" type="button" class="h-fit cursor-pointer hidden md:block" aria-label="Close menu" set:html={close} />
        <Button href={contact.href}>{contact.label}</Button>
      </div>
      <nav class="flex flex-col">
        {links.map((l) => (
          <a href={l.href} @click="modalIsOpen = false" class="p-3 flex items-center justify-between rounded-lgx text-sm font-medium transition-all hover:bg-gray-600 hover:px-6">
            {l.label} <Fragment set:html={arrow} />
          </a>
        ))}
        <a href={contact.href} @click="modalIsOpen = false" class="p-3 flex items-center justify-between rounded-lgx text-sm font-medium transition-all hover:bg-gray-600 hover:px-6 md:hidden">
          {contact.label}<Fragment set:html={arrow} />
        </a>
      </nav>
      <div class="p-3 pt-6">
        <div class="py-3 flex items-center justify-between">
          <p class="text-sm font-medium">Case Studies</p>
          <a href="/case-studies" class="text-xs underline transition-all hover:text-gray-300" @click="modalIsOpen = false">Show all</a>
        </div>
        <div class="flex gap-x-3 md:gap-x-4 md:pt-3">
          {featured.map((c) => (
            <a href={`/case-studies/${c.id}`} aria-label={c.data.listingTitle}>
              <img src={c.data.menuImage ?? c.data.listingImage} alt="" class="w-20 h-20 rounded-lgx object-cover transition-all duration-500 hover:scale-125 hover:z-30" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>
