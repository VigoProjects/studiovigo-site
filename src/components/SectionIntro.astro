---
/** Centred eyebrow + statement used to open many sections. heading accepts inline Markdown (links). */
import { mdInline } from "../lib/site";
interface Props { eyebrow?: string; heading: string; tag?: "h1" | "h2" }
const { eyebrow, heading, tag = "h2" } = Astro.props;
const Tag = tag;
---
<div class="flex flex-col gap-y-6 md:gap-y-8 md:max-w-[616px] md:mx-auto items-center text-center text-gray-500">
  {eyebrow && <Tag class="uppercase text-xsx">{eyebrow}</Tag>}
  <div class="text-3xl font-bold leading-snug mx-3 [&_a]:underline"><p set:html={mdInline(heading)} /></div>
  <slot />
</div>
