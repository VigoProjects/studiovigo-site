---
/** Text section (Markdown) with optional glow-framed image alongside. */
import type { z } from "astro/zod";
import type { prose } from "../../content/blocks";
import GlowCard from "../GlowCard.astro";
import { md } from "../../lib/site";
type Props = z.infer<typeof prose>;
const { eyebrow, heading, body, image, id, background } = Astro.props;
const html = (eyebrow ? `<h2>${eyebrow}</h2>` : "") + (heading ? `<h3>${heading}</h3>` : "") + md(body);
---
<div id={id} class:list={["section-spacing container py-14 lg:py-18 xl:py-31 scroll-mt-20", background === "grey" && "bg-gray-200"]}>
  <div class="flex flex-col gap-y-10 md:gap-x-14 lg:gap-x-20 md:items-center md:flex-col lg:flex-row">
    <div class="rich-text flex-1 flex flex-col gap-y-6" set:html={html} />
    {image && (
      <div class="flex-1 w-full">
        <GlowCard class="mx-auto" innerClass="aspect-3/2">
          <img src={image.src} alt={image.alt} class="w-full h-full object-cover" loading="lazy" />
        </GlowCard>
      </div>
    )}
  </div>
</div>
