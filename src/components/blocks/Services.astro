---
import type { z } from "astro/zod";
import type { services } from "../../content/blocks";
import Section from "../Section.astro";
import Eyebrow from "../Eyebrow.astro";
import Button from "../Button.astro";
type Props = z.infer<typeof services>;
const { eyebrow, heading, items, allHeading, allBody, allItems, id, background } = Astro.props;
---
<Section id={id} background={background} class="flex flex-col gap-y-8 md:gap-y-14">
  <div class="flex flex-col gap-y-4">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h2 class="max-w-3xl text-3xl font-bold text-gray-500 md:text-4xl">{heading}</h2>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    {items.map((s) => (
      <article class="flex flex-col justify-between gap-y-8 rounded-3xl bg-gray-200 p-8">
        <div class="flex flex-col gap-y-3">
          <h3 class="text-2xlx font-bold text-gray-500">{s.title}</h3>
          <p class="text-sm text-gray-400">{s.body}</p>
        </div>
        {s.href && <Button href={s.href} variant="light">Learn More</Button>}
      </article>
    ))}
  </div>
  {allItems && (
    <div class="flex flex-col gap-y-6">
      {allHeading && <h3 class="text-2xlx font-bold text-gray-500">{allHeading}</h3>}
      {allBody && <p class="text-sm text-gray-400">{allBody}</p>}
      <ul class="flex flex-wrap gap-3">
        {allItems.map((i) => <li class="rounded-full border border-gray-250 px-5 py-2 text-sm font-medium text-gray-500">{i}</li>)}
      </ul>
    </div>
  )}
</Section>
