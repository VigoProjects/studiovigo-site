---
import type { z } from "astro/zod";
import type { contactForm } from "../../content/blocks";
import Section from "../Section.astro";
type Props = z.infer<typeof contactForm>;
const { heading, body, id, background } = Astro.props;
const field = "w-full rounded-2xl border border-gray-250 bg-white px-5 py-3.5 text-sm text-gray-500 placeholder:text-gray-375 focus:border-gray-500 focus:outline-none";
---
<Section id={id} background={background}>
  <div class="grid gap-10 lg:grid-cols-2">
    <div class="flex flex-col gap-y-4">
      <h2 class="text-3xl font-bold text-gray-500 md:text-4xl">{heading}</h2>
      {body && <p class="text-smx text-gray-400">{body}</p>}
    </div>
    <form method="post" action="/api/contact" class="contact-form flex flex-col gap-4" data-contact-form>
      <input class={field} name="your_name" placeholder="Your name" required autocomplete="name" />
      <input class={field} name="email_address" type="email" placeholder="Email address" required autocomplete="email" />
      <input class={field} name="telephone_number" type="tel" placeholder="Telephone Number" autocomplete="tel" />
      <input class={field} name="business_name" placeholder="Business name" autocomplete="organization" />
      <textarea class={field} name="brief_outline_of_your_enquiry" rows="5" placeholder="Brief outline of your enquiry" required></textarea>
      <!-- Honeypot: humans never see or fill this -->
      <input type="text" name="honeypot" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <button type="submit" class="w-fit rounded-full bg-gray-500 px-5 py-2.25 text-sm font-medium text-white transition-colors hover:bg-gray-600 disabled:opacity-60">Send Message</button>
      <p class="text-sm" role="status" data-status></p>
    </form>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-status]")!;
      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      btn.disabled = true;
      status.textContent = "Sending…";
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.error || "Something went wrong.");
        form.reset();
        status.textContent = "Thanks — we normally reply within 24 hours.";
        (window as any).dataLayer?.push({ event: "contact_form_submit" });
      } catch (err) {
        status.textContent = (err as Error).message + " Please email us instead.";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
