---
import type { z } from "astro/zod";
import type { contactForm } from "../../content/blocks";
import ContactFormFields from "../ContactFormFields.astro";
type Props = z.infer<typeof contactForm>;
const { heading, body, id } = Astro.props;
---
<div id={id} class="bg-gray-200 scroll-mt-20">
  <div class="container px-2 pt-6 pb-13 md:pb-22 md:pt-14 md:px-24 xl:px-0 xl:grid xl:grid-cols-3 xl:pt-20 xl:pb-31 xl:gap-x-17">
    <div class="pb-6 md:pb-17 xl:pb-0 flex flex-col gap-y-6 xl:col-span-1">
      <p class="text-gray-500 text-xlx font-bold">{heading}</p>
      {body && <div class="text-smx leading-7 text-gray-400 flex flex-col gap-y-6"><p>{body}</p></div>}
    </div>
    <div class="xl:col-span-2"><ContactFormFields /></div>
  </div>
</div>
