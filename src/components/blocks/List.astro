---
/** Centred list with tick icons. Items are Markdown — use **bold** for the lead-in. */
import type { z } from "astro/zod";
import type { list } from "../../content/blocks";
import { mdInline } from "../../lib/site";
type Props = z.infer<typeof list>;
const { eyebrow, heading, items, id, background } = Astro.props;
---
<div id={id} class:list={["section-spacing container py-14 lg:py-18 xl:py-31 scroll-mt-20", background === "grey" && "bg-gray-200"]}>
  <div class="rich-text max-w-[768px] mx-auto flex flex-col gap-y-6">
    {eyebrow && <h2>{eyebrow}</h2>}
    {heading && <h3>{heading}</h3>}
    <ul>{items.map((i) => <li><p set:html={mdInline(i)} /></li>)}</ul>
  </div>
</div>
