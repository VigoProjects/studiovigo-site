---
import type { z } from "astro/zod";
import type { cta } from "../../content/blocks";
import Section from "../Section.astro";
import Button from "../Button.astro";
type Props = z.infer<typeof cta>;
const { heading, body, cta: link, id, background } = Astro.props;
---
<Section id={id} background={background}>
  <div class="flex flex-col items-center gap-y-6 text-center">
    <h2 class="text-3xl font-bold text-gray-500 md:text-4xl">{heading}</h2>
    {body && <p class="max-w-xl text-smx text-gray-400">{body}</p>}
    <Button href={link.href}>{link.label}</Button>
  </div>
</Section>
