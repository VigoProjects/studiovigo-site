---
/** In-page call to action (the site-wide closing CTA lives in the footer). */
import type { z } from "astro/zod";
import type { cta } from "../../content/blocks";
import SectionIntro from "../SectionIntro.astro";
import Button from "../Button.astro";
type Props = z.infer<typeof cta>;
const { heading, body, cta: link, id, background } = Astro.props;
---
<div id={id} class:list={["section-spacing container py-14 md:py-18 lg:py-31", background === "grey" && "bg-gray-200"]}>
  <SectionIntro {heading}>
    {body && <p class="text-smx leading-7 text-gray-400">{body}</p>}
    <Button href={link.href} variant="dark-outline" size="lg">{link.label}</Button>
  </SectionIntro>
</div>
