---
import type { z } from "astro/zod";
import type { testimonials } from "../../content/blocks";
import Testimonials from "../Testimonials.astro";
type Props = z.infer<typeof testimonials>;
const { id, background } = Astro.props;
---
<div id={id} class:list={[background === "grey" && "bg-gray-200"]}>
  <div class="container py-14 md:py-18 lg:py-31"><Testimonials /></div>
</div>
