---
import type { z } from "astro/zod";
import type { logos } from "../../content/blocks";
type Props = z.infer<typeof logos>;
const { heading, items, id } = Astro.props;
---
<section id={id} class="py-14 md:py-20">
  <div class="container flex flex-col items-center gap-y-6">
    <p class="text-center text-xsx uppercase text-gray-400">{heading}</p>
    <div class="flex flex-col items-center gap-y-2 md:flex-row md:flex-wrap md:justify-center md:gap-x-6 lg:justify-between xl:justify-around">
      {items.map((l) => <img src={l.src} alt={l.alt} class="max-w-36 lg:max-w-32" loading="lazy" />)}
    </div>
  </div>
</section>
