---
import type { z } from "astro/zod";
import type { caseStudies } from "../../content/blocks";
import { getCollection } from "astro:content";
import SectionIntro from "../SectionIntro.astro";
import FeaturedCaseStudyCard from "../FeaturedCaseStudyCard.astro";
import Testimonials from "../Testimonials.astro";
type Props = z.infer<typeof caseStudies>;
const { eyebrow, heading, featured, showTestimonials, id } = Astro.props;
const all = await getCollection("caseStudies", (e) => !e.data.draft);
const items = featured.map((slug) => {
  const e = all.find((c) => c.id === slug);
  if (!e) throw new Error(`caseStudies block: no case study called "${slug}"`);
  if (!e.data.featuredCard) throw new Error(`caseStudies block: "${slug}" has no featuredCard art in its front matter`);
  return e;
});
---
<div id={id} class="bg-gray-200 scroll-mt-20">
  <div class="container py-16 md:py-18 lg:py-31 flex flex-col gap-y-14 md:gap-y-20">
    <SectionIntro {eyebrow} {heading} />
    <div class="flex flex-col gap-y-4 lg:flex-row lg:gap-x-10 md:px-14 lg:px-0">
      {items.map((e, i) => <FeaturedCaseStudyCard entry={e} index={i} />)}
    </div>
    {showTestimonials && <Testimonials />}
  </div>
</div>
