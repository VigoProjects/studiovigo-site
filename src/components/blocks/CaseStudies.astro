---
import type { z } from "astro/zod";
import type { caseStudies } from "../../content/blocks";
import { getCollection } from "astro:content";
import Section from "../Section.astro";
import Eyebrow from "../Eyebrow.astro";
import CaseStudyCard from "../CaseStudyCard.astro";
import Testimonials from "./Testimonials.astro";
type Props = z.infer<typeof caseStudies>;
const { eyebrow, heading, featured, showTestimonials, id, background } = Astro.props;
const all = (await getCollection("caseStudies")).sort((a, b) => a.data.order - b.data.order);
const items = featured ? featured.map((s) => all.find((e) => e.id === s)).filter((e) => !!e) : all;
---
<Section id={id} background={background}>
  <div class="flex flex-col gap-y-4">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h2 class="max-w-3xl text-3xl font-bold text-gray-500 md:text-4xl">{heading}</h2>
  </div>
  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {items.map((e) => <CaseStudyCard entry={e} />)}
  </div>
  {showTestimonials && <div class="mt-14"><Testimonials type="testimonials" background="white" embedded /></div>}
</Section>
