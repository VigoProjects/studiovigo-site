---
import type { z } from "astro/zod";
import type { hero } from "../../content/blocks";
import Button from "../Button.astro";
type Props = z.infer<typeof hero> & { isPageTitle?: boolean };
const { eyebrow, heading, highlight, body, cta, video, image, id, isPageTitle = true } = Astro.props;
const Eyebrow = isPageTitle ? "h1" : "p";
const Heading = isPageTitle ? "p" : "h2";
---
<section id={id} class="group relative z-10 overflow-hidden bg-white">
  <div class="gradient-hero gradient-hero--animated pointer-events-none absolute inset-0 -top-5 z-10 h-17 opacity-100 blur-2xl xl:h-25"></div>
  <div class="gradient-hero gradient-hero--animated pointer-events-none absolute inset-0 z-10 h-36 opacity-20 blur-3xl xl:h-50"></div>
  <div class="container flex flex-col items-center gap-y-8.5 py-14 pt-28 text-center md:gap-y-6 md:pb-24 xl:flex-row xl:py-34 xl:text-left">
    {video && <video src={video} class="w-full md:max-w-xl xl:order-1 xl:max-w-[870px]" autoplay muted loop playsinline></video>}
    {!video && image && <img src={image.src} alt={image.alt} class="w-full md:max-w-xl xl:order-1 xl:max-w-[870px]" />}
    <div class="relative z-20 flex flex-col gap-y-8 md:max-w-[28rem]">
      <div class="flex flex-col gap-y-3">
        {eyebrow && <Eyebrow class="text-xsx font-bold tracking-normal text-gray-400 normal-case">{eyebrow}</Eyebrow>}
        <Heading class="text-4xl font-bold text-gray-500 md:text-[50px] md:leading-[1.1]">
          {heading}
          {highlight && <><br /><span class="bg-gradient-to-r from-purple-500 to-blue-500 bg-clip-text text-transparent">{highlight}</span></>}
        </Heading>
      </div>
      {body && <p class="text-sm text-gray-500">{body}</p>}
      {cta && <div class="flex justify-center xl:justify-start"><Button href={cta.href}>{cta.label}</Button></div>}
    </div>
  </div>
</section>
