---
/** Homepage-style hero: animated gradient wash, eyebrow, big heading with gradient highlight, video/image. */
import type { z } from "astro/zod";
import type { hero } from "../../content/blocks";
import Button from "../Button.astro";
type Props = z.infer<typeof hero> & { isPageTitle?: boolean };
const { eyebrow, heading, highlight, after, body, cta, secondaryCta, video, image, id, isPageTitle = true } = Astro.props;
const Eyebrow = isPageTitle ? "h1" : "p";
---
<div id={id} class="relative group overflow-hidden bg-white z-10">
  <div class="absolute inset-0 -top-5 z-10 gradient-hero gradient-hero--animated h-17 xl:h-25 opacity-100 blur-2xl pointer-events-none"></div>
  <div class="absolute inset-0 z-10 gradient-hero gradient-hero--animated h-36 xl:h-50 opacity-20 blur-4xl pointer-events-none"></div>
  <div class="container py-14 md:pb-24 text-center items-center flex flex-col gap-y-8.5 md:gap-y-6 xl:flex-row xl:py-34 xl:text-left">
    {video && <video src={video} class="w-full md:max-w-xl xl:order-1 xl:max-w-[870px]" autoplay muted loop playsinline aria-hidden="true"></video>}
    {!video && image && <img src={image.src} alt={image.alt} class="w-full md:max-w-xl xl:order-1 xl:max-w-[870px]" />}
    <div class="relative z-20 flex flex-col gap-y-8 md:max-w-smx">
      <div class="flex flex-col gap-y-3">
        {eyebrow && <Eyebrow class="text-xsx tracking-normal font-bold text-gray-400">{eyebrow}</Eyebrow>}
        <div class="text-4xl md:text-5xlx font-bold text-gray-500" role={isPageTitle && !eyebrow ? "heading" : undefined}>
          <div class="inline [&>*]:inline"><p>{heading}</p></div>
          {highlight && <> <div class="accent-text inline [&>*]:inline">{highlight}</div></>}
          {after && <> <div class="inline [&>*]:inline"><p>{after}</p></div></>}
        </div>
      </div>
      {body && <div><div class="text-smx leading-7 text-gray-400 flex flex-col gap-y-8 xl:gap-y-14"><p>{body}</p></div></div>}
      {(cta || secondaryCta) && (
        <div class="flex justify-center gap-x-4 xl:justify-start">
          {cta && <Button href={cta.href} variant="dark-outline" size="lg">{cta.label}</Button>}
          {secondaryCta && <Button href={secondaryCta.href} variant="light" size="lg">{secondaryCta.label}</Button>}
        </div>
      )}
    </div>
  </div>
  <div class="absolute inset-0 top-auto -bottom-5 z-10 gradient-hero-reverse gradient-hero-reverse--animated h-17 xl:h-25 opacity-50 blur-2xl pointer-events-none"></div>
  <div class="absolute inset-0 top-auto bottom-0 z-10 gradient-hero-reverse gradient-hero-reverse--animated h-36 xl:h-50 opacity-20 blur-4xl pointer-events-none"></div>
</div>
