---
import type { z } from "astro/zod";
import type { stats } from "../../content/blocks";
import StatGrid from "../StatGrid.astro";
type Props = z.infer<typeof stats>;
const { heading, body, items, id, background } = Astro.props;
---
<div id={id} class:list={["section-spacing py-14 md:py-18 lg:py-31", background === "grey" && "bg-gray-200"]}>
  <div class="container"><StatGrid {heading} {body} {items} /></div>
</div>
