---
import type { z } from "astro/zod";
import type { stats } from "../../content/blocks";
import Section from "../Section.astro";
type Props = z.infer<typeof stats>;
const { heading, body, items, id, background } = Astro.props;
---
<Section id={id} background={background}>
  <div class="flex flex-col gap-y-10 md:gap-y-14">
    <div class="flex max-w-3xl flex-col gap-y-4">
      <h2 class="text-3xl font-bold text-gray-500 md:text-4xl">{heading}</h2>
      {body && <p class="text-smx text-gray-400">{body}</p>}
    </div>
    <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((s) => (
        <div class="flex flex-col-reverse gap-y-3 rounded-3xl bg-gray-200 p-8">
          <dt class="text-sm text-gray-400">{s.label}</dt>
          <dd class="bg-gradient-to-r from-purple-500 to-blue-500 bg-clip-text text-6xl font-bold text-transparent">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
