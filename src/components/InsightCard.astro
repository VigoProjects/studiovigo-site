---
import type { CollectionEntry } from "astro:content";
interface Props { entry: CollectionEntry<"insights"> }
const { entry } = Astro.props;
const d = entry.data;
const date = d.date.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" });
---
<a href={`/insights/${entry.id}`} class="group flex flex-col gap-y-4">
  {d.image && <img src={d.image} alt="" class="aspect-[16/10] w-full rounded-3xl object-cover" loading="lazy" />}
  <p class="text-xs text-gray-400">{d.author} | {date}</p>
  <h3 class="text-xlx font-bold text-gray-500 group-hover:underline">{d.title}</h3>
</a>
