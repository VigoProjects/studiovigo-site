---
/**
 * Vigo's signature card: white panel with a soft gradient glow that scales in on scroll.
 * gradient: coral-blue | purple-teal | teal-blue | coral-purple
 * Use `gradientFor(i)` from src/lib/gradients to cycle gradients across a list of cards.
 */
import type { Gradient } from "../lib/gradients";

interface Props { gradient?: Gradient; class?: string; innerClass?: string }
const { gradient = "coral-blue", class: cls = "", innerClass = "h-full" } = Astro.props;
---
<div x-data="{ scrolledIntoView: false }" x-intersect.threshold.75="scrolledIntoView = true" x-intersect:leave.threshold.75="scrolledIntoView = false" class={cls}>
  <div class="transition-all duration-500 ease-out relative scale-95 transform-gpu w-full h-full motion-reduce:isolate motion-reduce:transform-none motion-reduce:transition-none" :class="scrolledIntoView === true ? 'scale-100' : 'scale-95'">
    <div class="transition-opacity duration-500 ease-out opacity-0 motion-reduce:transition-none" :class="scrolledIntoView === true ? 'opacity-100' : 'opacity-0 pointer-events-none'">
      <div class:list={["absolute inset-0 -z-10 w-full h-full opacity-10 blur-sm", `card-gradient-${gradient}`]}></div>
      <div class:list={["absolute inset-0 -z-10 w-full h-full opacity-50 scale-90 blur-2xl", `card-gradient-${gradient}`]}></div>
    </div>
    <div class="rounded-lgx relative p-2 w-full h-full bg-white">
      <div class:list={["rounded-lgx overflow-hidden", innerClass]}><slot /></div>
    </div>
  </div>
</div>
