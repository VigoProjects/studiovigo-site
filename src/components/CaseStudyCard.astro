---
import type { CollectionEntry } from "astro:content";
interface Props { entry: CollectionEntry<"caseStudies"> }
const { entry } = Astro.props;
const d = entry.data;
---
<a href={`/case-studies/${entry.id}`} class="group flex flex-col overflow-hidden rounded-3xl bg-white transition-shadow hover:shadow-xl">
  {d.image && <img src={d.image} alt="" class="aspect-[4/3] w-full object-cover" loading="lazy" />}
  <div class="flex flex-1 flex-col gap-y-4 p-8">
    <ul class="flex flex-wrap gap-2">
      {d.tags.map((t) => <li class="rounded-full bg-gray-200 px-3 py-1 text-2xs font-medium text-gray-400">{t}</li>)}
    </ul>
    <h3 class="text-xlx font-bold text-gray-500">{d.headline}</h3>
    <span class="mt-auto text-sm font-medium text-gray-500 underline-offset-4 group-hover:underline">Read Case Study</span>
  </div>
</a>
