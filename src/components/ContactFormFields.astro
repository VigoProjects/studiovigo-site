---
/** The enquiry form (floating-label fields), ported from the live site. Posts to /api/contact. */
const fields = [
  { name: "your_name", label: "Your name", type: "text", required: true, autocomplete: "name" },
  { name: "email_address", label: "Email address", type: "email", required: true, autocomplete: "email" },
  { name: "telephone_number", label: "Telephone Number", type: "tel", required: false, autocomplete: "tel" },
  { name: "business_name", label: "Business name", type: "text", required: false, autocomplete: "organization" },
];
const wrap = "h-full px-6 py-4.5 rounded-lgx bg-white border-[1px] border-gray-150 relative transition-all hover:border-gray-175 focus-within:border-gray-175 focus-within:[&>label]:top-3 focus-within:[&>label]:text-2xs";
const input = "w-full h-full focus:outline-none translate-y-3 text-gray-400 font-medium text-sm bg-transparent";
const uid = Math.random().toString(36).slice(2, 7);
---
<form method="post" action="/api/contact" data-contact-form
  x-data="{ state: 'idle', message: '' }"
  @submit.prevent="
    state = 'sending';
    fetch($el.action, { method: 'POST', body: new FormData($el), headers: { Accept: 'application/json' } })
      .then(async (r) => { const j = await r.json().catch(() => ({})); if (!r.ok) throw new Error(j.error || 'Something went wrong.'); return j; })
      .then(() => { state = 'sent'; message = 'Thanks — we normally reply within 24 hours.'; $el.reset(); window.dataLayer && window.dataLayer.push({ event: 'contact_form_submit' }); })
      .catch((e) => { state = 'error'; message = e.message + ' Please try again, or email us directly.'; })
  ">
  <div class="flex flex-col gap-y-4">
    <div class="flex flex-col gap-4 w-full xl:flex-row">
      <div class="flex flex-col gap-y-4 w-full flex-1">
        {fields.map((f) => (
          <div x-data="{ isPlaceholder: true }" class={wrap}>
            <label for={`${uid}-${f.name}`} class="absolute transition-all text-gray-400 left-6" :class="isPlaceholder===true ? 'top-5 text-sm' : 'top-3 text-2xs'">{f.label}</label>
            <input id={`${uid}-${f.name}`} class={input} @input="isPlaceholder = $event.target.value === ''" type={f.type} name={f.name} required={f.required} autocomplete={f.autocomplete} />
          </div>
        ))}
      </div>
      <div class="flex-1">
        <div x-data="{ isPlaceholder: true }" class={wrap}>
          <label for={`${uid}-msg`} class="absolute transition-all text-gray-400 left-6" :class="isPlaceholder===true ? 'top-5 text-sm' : 'top-3 text-2xs'">Brief outline of your enquiry</label>
          <textarea id={`${uid}-msg`} class={input} @input="isPlaceholder = $event.target.value === ''" name="brief_outline_of_your_enquiry" rows="5" required></textarea>
        </div>
      </div>
    </div>
    <!-- Honeypot: hidden from humans, bots fill it in -->
    <input type="text" class="hidden" name="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="flex flex-col items-center gap-3 xl:flex-row-reverse xl:justify-between">
      <button type="submit" :disabled="state === 'sending'" class="cursor-pointer flex items-center gap-x-3 w-fit rounded-full text-sm leading-snug font-medium transition-all duration-300 ease-in-out group bg-gray-500 outline-2 -outline-offset-1 outline-solid outline-gray-500 text-white hover:outline-4 px-5 py-2.25 disabled:opacity-60">
        <span x-text="state === 'sending' ? 'Sending…' : 'Send Message'">Send Message</span>
      </button>
      <p x-show="message" x-cloak x-text="message" role="status" class="text-sm" :class="state === 'error' ? 'text-coral-500' : 'text-gray-500'"></p>
    </div>
  </div>
</form>
