---
/** Closing CTA + footer, ported from the live site. Text comes from src/content/site.yaml. */
import { site } from "../lib/site";
import Logo from "./Logo.astro";
import Button from "./Button.astro";
const year = new Date().getFullYear();
---
<footer class="bg-gray-500 relative overflow-hidden">
  <div class="relative group overflow-hidden bg-white z-10 transition-all duration-500 lg:hover:rounded-lgx lg:hover:scale-y-[0.9] lg:hover:scale-x-[0.98]">
    <div class="absolute inset-0 -top-5 gradient-hero h-32 opacity-50 blur-xl xl:w-full md:w-200vw -z-10"></div>
    <div class="container py-24 md:py-30 lg:hover:py-27 text-center items-center flex flex-col gap-y-6 lg:hover:gap-y-7 transition-all duration-500 lg:group-hover:scale-x-[1.02] lg:group-hover:scale-y-[1.1]">
      <p class="text-xlx font-lexend font-extrabold text-gray-500">{site.cta.heading}</p>
      <div class="max-w-[352px]">
        <div class="text-smx leading-7 text-gray-400 flex flex-col gap-y-8 xl:gap-y-14"><p>{site.cta.body}</p></div>
      </div>
      <Button href={site.cta.href} variant="dark-outline" size="lg">{site.cta.label}</Button>
    </div>
    <img src="/permanent-assets/footer-cta-1.png" alt="" loading="lazy" class="w-1/2 md:w-1/3 xl:w-1/4 max-w-84 absolute -left-3 -bottom-2 -z-10 transition-all duration-300 lg:group-hover:scale-125" />
    <img src="/permanent-assets/footer-cta-2.png" alt="" loading="lazy" class="w-1/2 md:w-1/3 xl:w-1/4 max-w-84 absolute -right-5 -bottom-2 -z-10 transition-all duration-300 lg:group-hover:scale-125" />
  </div>

  <div class="container bg-gray-500 pt-16 pb-31 md:py-10 xl:pt-20 xl:pb-6">
    <div class="flex flex-col gap-y-14 md:gap-y-18 xl:gap-y-16 text-center items-center">
      <div class="flex flex-col gap-y-14 md:gap-y-18 text-center items-center xl:flex-row xl:relative xl:justify-center xl:w-full">
        <nav class="flex flex-col md:flex-row gap-y-4 md:gap-x-12 md:order-1 xl:order-0 xl:grid xl:grid-cols-2 xl:absolute xl:left-0 xl:text-left">
          {site.footerNav.map((l) => <a href={l.href} class="text-sm text-gray-100 hover:text-gray-300 transition-colors duration-500">{l.label}</a>)}
        </nav>
        <div>
          <p class="text-xs text-gray-100 mb-7 md:mb-4">
            {site.offices.map((o, i) => <>{i > 0 && " | "}{o.city.toUpperCase()}: {o.address}</>)}
          </p>
          <div class="flex flex-col md:flex-row md:gap-x-9 items-center gap-y-9">
            <img src="/assets/test-logo.svg" alt="Vigo Product Development Studio" class="w-31" loading="lazy" />
          </div>
        </div>
        {site.clutchCompanyId && (
          <div id="clutch-badge" class="flex w-[213px] max-w-full justify-center xl:absolute xl:right-0">
            <div class="clutch-widget" data-url="https://widget.clutch.co" data-widget-type="14" data-height="50" data-nofollow="true" data-expandifr="true" data-scale="100" data-clutchcompany-id={site.clutchCompanyId}></div>
            <script is:inline src="https://widget.clutch.co/static/js/widget.js" defer></script>
          </div>
        )}
      </div>
      <p class="text-gray-350 text-xs leading-normal md:order-1">
        Copyright © {site.company}, {year}. <br class="md:hidden" />All Rights Reserved.
      </p>
      <a href="/" aria-label={`${site.name} home`} class="absolute bottom-0 flex justify-center md:right-0 after:md:right-0 after:bg-gray-600 after:w-35 after:h-18 after:md:h-24 after:clip-footer-logo after:md:clip-footer-logo-xl after:block after:absolute after:bottom-0 after:mx-auto after:transition-all after:duration-500 group hover:after:scale-110 hover:after:duration-500">
        <Logo class="bottom-0 w-10.5 mb-2 ml-2 h-13 md:mb-3.5 md:mr-8.5 z-10 transition-all duration-500 group-hover:scale-110" pathClass="md:fill-gray-375 group-hover:md:fill-white" />
      </a>
    </div>
  </div>
</footer>
