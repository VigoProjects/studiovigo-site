---
import { site } from "../lib/site";
import Button from "./Button.astro";
const year = new Date().getFullYear();
---
<section class="container mx-auto px-5 py-14 lg:py-31">
  <div class="relative overflow-hidden rounded-3xl bg-gray-200 px-8 py-14 text-center md:px-14">
    <h2 class="text-3xl font-bold text-gray-500 md:text-4xl">{site.cta.heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-smx text-gray-400">{site.cta.body}</p>
    <div class="mt-8 flex justify-center"><Button href={site.cta.href}>{site.cta.label}</Button></div>
    <img src="/permanent-assets/footer-cta-1.png" alt="" class="pointer-events-none absolute -bottom-6 -left-6 hidden w-48 md:block" loading="lazy" />
    <img src="/permanent-assets/footer-cta-2.png" alt="" class="pointer-events-none absolute -top-6 -right-6 hidden w-48 md:block" loading="lazy" />
  </div>
</section>

<footer class="bg-gray-600 text-white">
  <div class="container mx-auto flex flex-col gap-y-8 px-5 py-12">
    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium">
      {site.footerNav.map((l) => <a href={l.href} class="hover:text-gray-300">{l.label}</a>)}
    </nav>
    <p class="text-xs text-gray-300">
      {site.offices.map((o, i) => <>{i > 0 && " | "}<strong class="font-bold">{o.city.toUpperCase()}:</strong> {o.address}</>)}
    </p>
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <img src="/assets/test-logo.svg" alt="Vigo Product Development Studio" class="h-12 w-auto" loading="lazy" />
      <p class="text-xs text-gray-300">Copyright © {site.company}, {year}.<br />All Rights Reserved.</p>
    </div>
  </div>
</footer>
