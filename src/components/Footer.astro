---
/** Closing CTA band + footer. Text comes from `cta`, `footer` and `offices` in src/content/site.yaml. */
import { site } from "../lib/site";
import Logo from "./Logo.astro";
import Button from "./Button.astro";
const year = new Date().getFullYear();
/** Visible keyboard focus for every footer link. */
const link = "rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-500";
---
<footer class="bg-gray-200 relative overflow-hidden">
  <div class="relative group overflow-hidden bg-white z-10 transition-all duration-500 lg:hover:rounded-lgx lg:hover:scale-y-[0.9] lg:hover:scale-x-[0.98]">
    <div class="absolute inset-0 -top-5 gradient-hero h-32 opacity-50 blur-xl xl:w-full md:w-200vw -z-10"></div>
    <div class="container py-24 md:py-30 lg:hover:py-27 text-center items-center flex flex-col gap-y-6 lg:hover:gap-y-7 transition-all duration-500 lg:group-hover:scale-x-[1.02] lg:group-hover:scale-y-[1.1]">
      <p class="text-xlx font-lexend font-extrabold text-gray-500">{site.cta.heading}</p>
      <div class="max-w-[352px]">
        <div class="text-smx leading-7 text-gray-400 flex flex-col gap-y-8 xl:gap-y-14"><p>{site.cta.body}</p></div>
      </div>
      <Button href={site.cta.href} variant="dark-outline" size="lg">{site.cta.label}</Button>
    </div>
    <img src="/permanent-assets/footer-cta-1.png" alt="" loading="lazy" class="w-1/2 md:w-1/3 xl:w-1/4 max-w-84 absolute -left-3 -bottom-2 -z-10 transition-all duration-300 lg:group-hover:scale-125" />
    <img src="/permanent-assets/footer-cta-2.png" alt="" loading="lazy" class="w-1/2 md:w-1/3 xl:w-1/4 max-w-84 absolute -right-5 -bottom-2 -z-10 transition-all duration-300 lg:group-hover:scale-125" />
  </div>

  <!--
    Footer: intro + contact on the left, link columns on the right, then a hairline and the
    brush-script signature as a sign-off. All text comes from `footer` and `offices` in site.yaml.
  -->
  <div class="container pt-18 md:pt-22 xl:pt-25 pb-8">
    <div class="grid gap-y-14 xl:grid-cols-12 xl:gap-x-10">
      <div class="xl:col-span-5 flex flex-col gap-y-8">
        <p class="max-w-[22rem] text-smx leading-7 text-gray-400">{site.footer.intro}</p>
        <div class="flex flex-col items-start gap-y-2">
          {site.footer.contact.map((c, i) => (
            <a href={c.href} class:list={[link, i === 0 ? "text-xlx font-bold text-gray-500 hover:underline decoration-2 underline-offset-6" : "text-smx text-gray-500 hover:underline underline-offset-4"]}>{c.label}</a>
          ))}
        </div>
        {(site.clutchCompanyId || site.footerBadges?.length) && (
          <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
            {site.clutchCompanyId && (
              <div id="clutch-badge" class="w-[213px] max-w-full">
                <div class="clutch-widget" data-url="https://widget.clutch.co" data-widget-type="14" data-height="50" data-nofollow="true" data-expandifr="true" data-scale="100" data-clutchcompany-id={site.clutchCompanyId}></div>
                <script is:inline src="https://widget.clutch.co/static/js/widget.js" defer></script>
              </div>
            )}
            {site.footerBadges?.map((b) => {
              // The badge art includes a soft shadow margin; -my offsets it so the pill lines up with the Clutch widget.
              const img = <img src={b.src} alt={b.alt} class="h-[72px] w-auto -my-2.5 -ml-2" loading="lazy" />;
              return b.href ? <a href={b.href} target="_blank" rel="noopener" class={link}>{img}</a> : img;
            })}
          </div>
        )}
      </div>

      <div class="xl:col-span-7 grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-3">
        {site.footer.columns.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="text-smx font-bold text-gray-500">{col.heading}</h2>
            <ul class="mt-5 flex flex-col gap-y-3">
              {col.links.map((l) => <li><a href={l.href} class:list={[link, "text-sm text-gray-400 hover:text-gray-500 hover:underline underline-offset-4 transition-colors duration-300"]}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
        <div class="col-span-2 md:col-span-1">
          <h2 class="text-smx font-bold text-gray-500">{site.footer.officesHeading}</h2>
          <div class="mt-5 grid grid-cols-2 gap-x-8 gap-y-6 md:grid-cols-1">
            {site.offices.map((o) => (
              <div>
                <p class="text-sm font-medium text-gray-500">{o.city}</p>
                <address class="mt-1 not-italic text-sm leading-6 text-gray-400">
                  {o.address.split(",").map((line, i) => <>{i > 0 && <br />}{line.trim()}</>)}
                </address>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 md:mt-20 border-t border-gray-250 pt-8 flex flex-col gap-y-8 md:flex-row md:items-end md:justify-between">
      <a href="/" aria-label={`${site.name} home`} class:list={[link, "block w-fit transition-transform duration-500 hover:-rotate-3"]}>
        <Logo class="h-28 md:h-36 w-auto" pathClass="fill-gray-500" />
      </a>
      <div class="flex flex-col gap-y-3 text-xs text-gray-400 md:items-end md:text-right">
        <div class="flex gap-x-6">
          <button type="button" class:list={[link, "cursor-pointer hover:text-gray-500 hover:underline underline-offset-4"]}
            onclick="try { localStorage.removeItem('cookie-accepted') } catch (e) {} location.reload()">Cookie preferences</button>
          <a href="#" class:list={[link, "hover:text-gray-500 hover:underline underline-offset-4"]}>Back to top</a>
        </div>
        <p>© {year} {site.company}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
