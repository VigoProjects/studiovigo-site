---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { site } from "../lib/site";
import { organization, website, breadcrumbs as crumbs } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
  /** Full <title> override; otherwise "<title> | Vigo". */
  metaTitle?: string;
  /** Breadcrumb trail for search results, e.g. [["Insights", "/insights"], ["Title", "/insights/slug"]]. */
  breadcrumbs?: [string, string][];
  /** Extra JSON-LD objects for this page (Article, Service…). */
  schema?: object[];
}
const { title, description = site.tagline, ogImage, type = "website", metaTitle, breadcrumbs, schema = [] } = Astro.props;
// "| Vigo" is only appended when the result still fits Google's ~60-character display.
const suffixed = (t: string) => (`${t} | ${site.name}`.length <= 60 ? `${t} | ${site.name}` : t);
const fullTitle = metaTitle ?? (title === "Home" ? `Digital Product Agency for Complex Systems & Big Data | ${site.name}` : suffixed(title));
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const jsonLd = [
  ...(path === "/" ? [organization(), website()] : []),
  ...(path === "/contact" ? [organization()] : []),
  ...(breadcrumbs?.length ? [crumbs(breadcrumbs)] : []),
  ...schema,
];
const canonical = new URL(path, Astro.site).href;
const gtm = site.analytics?.gtm;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/made-tommy-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/made-tommy-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@100..900&display=swap" />
    {site.fontAwesomeKit && <script is:inline src={`https://kit.fontawesome.com/${site.fontAwesomeKit}.js`} crossorigin="anonymous" defer></script>}
    <style is:global>[x-cloak] { display: none !important; }</style>
    {gtm && (
      <script is:inline define:vars={{ gtm }}>
        (() => {
          let ok = false;
          try { ok = localStorage.getItem('cookie-accepted') === '1'; } catch (e) {}
          if (!ok) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm;
          document.head.appendChild(tag);
        })();
      </script>
    )}
  </head>
  <body class="relative overflow-x-hidden">
    <Header />
    <main><slot /></main>
    <Footer />
    <CookieBanner />
    <script>import "../scripts/alpine";</script>
  </body>
</html>
